    {"id": "comment_section1", "type": "comment", "z": "opcua_nodered_flow",
     "name": "═══ ESP32 BUTTON → DASHBOARD ═══",
     "info": "ESP32 publishes OPC UA PubSub JSON when button is pressed/released.\nNode-RED parses the NetworkMessage and shows state on dashboard.",
     "x": 220, "y": 40, "wires": []},
    {
        "id": "mqtt_in_button",
        "type": "mqtt in",
        "z": "opcua_nodered_flow",
        "name": "OPC UA Button",
        "topic": "opcua/json/nodered/button",
        "qos": "0",
        "datatype": "utf8",
        "broker": "opcua_mqtt_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [["parse_button_opcua"]]
    },
    {
        "id": "parse_button_opcua",
        "type": "function",
        "z": "opcua_nodered_flow",
        "name": "Parse OPC UA JSON",
        "func": "// Parse OPC UA PubSub NetworkMessage (IEC 62541-14)\nvar opcua = JSON.parse(msg.payload);\n\nif (opcua.MessageType !== \"ua-data\" || !opcua.Messages || !opcua.Messages.length) {\n    node.warn(\"Not a valid OPC UA data message\");\n    return null;\n}\n\nvar dsm = opcua.Messages[0];\nvar payload = dsm.Payload || {};\nvar buttonField = payload.Button || {};\nvar pressed = buttonField.Value || false;\n\nmsg.opcua = {\n    publisherId: opcua.PublisherId,\n    messageId: opcua.MessageId,\n    sequenceNumber: dsm.SequenceNumber,\n    timestamp: buttonField.SourceTimestamp\n};\n\nmsg.payload = pressed;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 120,
        "wires": [["ui_button_indicator", "debug_button", "format_button_debug"]]
    },
    {
        "id": "ui_button_indicator",
        "type": "ui-text",
        "z": "opcua_nodered_flow",
        "group": "opcua_ui_group_status",
        "name": "Button State",
        "order": 1,
        "width": "3",
        "height": "1",
        "label": "ESP32 Button:",
        "format": "{{msg.payload ? '🟢 PRESSED' : '⚫ RELEASED'}}",
        "layout": "row-spread",
        "style": false,
        "font": "",
        "fontSize": 16,
        "color": "#e0e0e0",
        "className": "",
        "x": 610,
        "y": 100,
        "wires": []
    },
    {
        "id": "debug_button",
        "type": "debug",
        "z": "opcua_nodered_flow",
        "name": "Button Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "true",
        "targetType": "full",
        "statusVal": "payload",
        "statusType": "msg",
        "x": 610,
        "y": 160,
        "wires": []
    },
    {
        "id": "format_button_debug",
        "type": "function",
        "z": "opcua_nodered_flow",
        "name": "Format for display",
        "func": "var info = msg.opcua || {};\nvar state = msg.payload ? \"PRESSED\" : \"RELEASED\";\nmsg.payload = \"[#\" + (info.sequenceNumber || \"?\") + \"] Button: \" + state + \" | Publisher: \" + (info.publisherId || \"?\");\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 220,
        "wires": [["ui_debug_text"]]
    },
    {"id": "comment_section2", "type": "comment", "z": "opcua_nodered_flow",
     "name": "═══ DASHBOARD → ESP32 LED ═══",
     "info": "Dashboard switch sends OPC UA PubSub JSON to ESP32.\nESP32 parses the NetworkMessage and toggles the LED.",
     "x": 210, "y": 300, "wires": []},
    {
        "id": "ui_led_switch",
        "type": "ui-switch",
        "z": "opcua_nodered_flow",
        "group": "opcua_ui_group_control",
        "name": "LED Control",
        "label": "ESP32 LED",
        "order": 1,
        "width": "3",
        "height": "1",
        "passthru": false,
        "decouple": false,
        "topic": "led",
        "topicType": "str",
        "style": "",
        "className": "",
        "onvalue": "true",
        "onvalueType": "bool",
        "onicon": "mdi-lightbulb",
        "oncolor": "#4CAF50",
        "offvalue": "false",
        "offvalueType": "bool",
        "officon": "mdi-lightbulb-outline",
        "offcolor": "#888888",
        "x": 150,
        "y": 380,
        "wires": [["format_led_opcua"]]
    },
    {
        "id": "format_led_opcua",
        "type": "function",
        "z": "opcua_nodered_flow",
        "name": "Format OPC UA JSON",
        "func": "// Build OPC UA PubSub NetworkMessage (IEC 62541-14)\nvar seq = flow.get(\"led_seq\") || 0;\nseq += 1;\nflow.set(\"led_seq\", seq);\n\nvar networkMessage = {\n    \"MessageId\": String(seq),\n    \"MessageType\": \"ua-data\",\n    \"PublisherId\": \"NodeRED-Dashboard\",\n    \"Messages\": [{\n        \"DataSetWriterId\": 2001,\n        \"SequenceNumber\": seq,\n        \"Payload\": {\n            \"LED\": {\n                \"Value\": msg.payload,\n                \"SourceTimestamp\": new Date().toISOString()\n            }\n        }\n    }]\n};\n\nmsg.payload = JSON.stringify(networkMessage);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 380,
        "wires": [["mqtt_out_led", "debug_led", "format_led_debug"]]
    },
    {
        "id": "mqtt_out_led",
        "type": "mqtt out",
        "z": "opcua_nodered_flow",
        "name": "OPC UA LED Cmd",
        "topic": "opcua/json/nodered/led/cmd",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "opcua_mqtt_broker",
        "x": 620,
        "y": 360,
        "wires": []
    },
    {
        "id": "debug_led",
        "type": "debug",
        "z": "opcua_nodered_flow",
        "name": "LED Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 600,
        "y": 420,
        "wires": []
    },
    {
        "id": "format_led_debug",
        "type": "function",
        "z": "opcua_nodered_flow",
        "name": "Format for display",
        "func": "var opcua = JSON.parse(msg.payload);\nvar val = opcua.Messages[0].Payload.LED.Value;\nmsg.payload = \"[#\" + opcua.MessageId + \"] LED: \" + (val ? \"ON\" : \"OFF\") + \" | Publisher: \" + opcua.PublisherId;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 480,
        "wires": [["ui_debug_text"]]
    },
    {"id": "comment_section3", "type": "comment", "z": "opcua_nodered_flow",
     "name": "═══ DEBUG / MESSAGE LOG ═══",
