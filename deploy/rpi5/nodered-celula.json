  {
    "id": "sis_monta",
    "type": "function",
    "z": "tab_sistema",
    "name": "Monta a página",
    "func": "// Junta o JSON do celula_status.py com a taxa MQTT medida aqui e monta a página\nconst s = msg.payload;\nconst agora = Date.now();\nconst dur = seg => {\n  if (!seg) return '—';\n  const d = Math.floor(seg / 86400), h = Math.floor(seg % 86400 / 3600),\n        m = Math.floor(seg % 3600 / 60);\n  return d ? `${d} d ${h} h` : h ? `${h} h ${m} min` : `${m} min ${seg % 60} s`;\n};\nconst svc = n => (s.servicos.find(x => x.nome === n) || {}).estado === 'active';\n\n// taxa de mensagens desde o último levantamento (contadas pelo nó \"Conta mensagens\")\nconst cont = flow.get('contagem') || 0, ant = flow.get('contagem_ant') || 0;\nconst tAnt = flow.get('t_ant') || agora;\nflow.set('contagem_ant', cont); flow.set('t_ant', agora);\nconst taxa = agora > tAnt ? (cont - ant) * 1000 / (agora - tAnt) : 0;\nconst ult = flow.get('ultima') || {};\nconst fresco = !!ult.t && agora - ult.t < 5000;\n\nconst lu = s.aas.last_update ? Date.parse(s.aas.last_update) : 0;\nconst aasFresco = s.aas.ok && lu && Math.abs(agora - lu) < 10000;\nconst itIp = s.broker.clientes_rede.join(', ');\n\nconst etapas = [\n  {nome: 'ESP32 OT', sub: 'Modbus RTU (J7)', ok: fresco,\n   info: fresco ? 'respondendo ao Modbus' : 'sem leituras'},\n  {nome: 'ESP32 IT', sub: 'OPC UA PubSub', ok: fresco && !!itIp,\n   info: itIp ? `${itIp} · ${taxa.toFixed(1)} msg/s` : 'fora do broker'},\n  {nome: 'Mosquitto', sub: 'MQTT :1883', ok: svc('mosquitto'),\n   info: `${s.broker.clientes_rede.length + s.broker.clientes_locais} clientes`},\n  {nome: 'Node-RED', sub: 'Dashboard :1880', ok: svc('nodered') && fresco,\n   info: fresco ? `Seq ${ult.seq}` : 'sem mensagens'},\n  {nome: 'aas-gateway', sub: 'MQTT → AAS', ok: svc('aas-gateway'),\n   info: svc('aas-gateway') ? 'BaSyx Python SDK' : 'parado'},\n  {nome: 'Eclipse BaSyx', sub: 'AAS Part 2 :8081', ok: !!aasFresco,\n   info: aasFresco ? `atualizado às ${new Date(lu).toLocaleTimeString('pt-BR')}` : (s.aas.erro || 'AAS parado')},\n];\n\nmsg.payload = {\n  etapas,\n  tudoOk: etapas.every(e => e.ok),\n  conteineres: s.conteineres.map(c => ({\n    nome: c.nome, funcao: c.funcao, imagem: c.imagem, portas: c.portas.join(', '),\n    ok: c.estado === 'running' && c.saude !== 'unhealthy',\n    estado: c.estado === 'running' ? (c.saude || 'running') : c.estado,\n    noAr: dur(c.no_ar_s), mem: c.mem_mb ? c.mem_mb + ' MB' : '—', restart: c.restart})),\n  projeto: (s.conteineres[0] || {}).projeto || '',\n  servicos: s.servicos.map(x => ({\n    nome: x.nome, funcao: x.funcao, ok: x.estado === 'active',\n    estado: x.estado + (x.sub ? ' (' + x.sub + ')' : ''), boot: x.boot,\n    noAr: dur(x.no_ar_s), mem: x.mem_mb ? x.mem_mb + ' MB' : '—'})),\n  host: Object.assign({}, s.host, {uptime: dur(s.host.uptime_s)}),\n  aas: s.aas,\n  atualizado: new Date().toLocaleTimeString('pt-BR'),\n};\nreturn msg;",
