    "id": "cel_watch",
    "type": "function",
    "name": "Vigia do gateway",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const t = flow.get('ultima_msg') || 0;\nconst s = (Date.now() - t) / 1000;\nif (s <= 3) return null;\nmsg.payload = t ? '🔴 sem dados há ' + Math.round(s) + ' s' : '🔴 aguardando o gateway IT';\nreturn msg;",
