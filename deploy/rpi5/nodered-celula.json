  {
    "id": "cel_decode",
    "type": "function",
    "name": "Decodifica NetworkMessage",
    "func": "// NetworkMessage (Part 14 JSON) -> valores simples\nconst nm = msg.payload;\nif (!nm || nm.MessageType !== 'ua-data' || !nm.Messages || !nm.Messages.length) return null;\nconst ds = nm.Messages[0];\nconst p = ds.Payload || {};\nconst v = k => (p[k] && typeof p[k] === 'object' && 'Value' in p[k]) ? p[k].Value : p[k];\nconst bad = k => p[k] && p[k].StatusCode !== undefined && (p[k].StatusCode & 0x80000000) !== 0;\n\nconst FASES = ['Parado', 'Aguardando peça + botão A', 'Pegando a peça',\n               'Transportando', 'Soltando na esteira', 'Esteira ligada'];\nflow.set('ultima_msg', Date.now());\n\nconst juntas = [['Base', 'JointBase'], ['Ombro', 'JointShoulder'],\n                ['Cotovelo', 'JointElbow'], ['Garra', 'JointGripper']];\nconst fase = v('AutoPhase');\nconst dist = bad('SensorDistance') ? 'sem leitura' : v('SensorDistance') + ' cm';\nconst ts = (p.JointBase && p.JointBase.SourceTimestamp) || '-';\n\nreturn [\n    {payload: v('JointBase')},\n    {payload: v('JointShoulder')},\n    {payload: v('JointElbow')},\n    {payload: v('JointGripper')},\n    juntas.map(([nome, k]) => ({topic: nome, payload: v(k)})),\n    {payload: v('ConveyorRunning') ? '🟢 Ligada (' + v('ConveyorSpeed') + ' %)' : '⚫ Parada'},\n    {payload: dist},\n    {payload: v('PieceDetected') ? '🟢 Sim' : '⚫ Não'},\n    {payload: fase + ' - ' + (FASES[fase] || '?')},\n    {payload: v('CycleCount')},\n    {payload: '🟢 #' + ds.SequenceNumber + '  ' + ts}\n];",
    "outputs": 11,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 300,
    "wires": [
      [
        "cel_g_base"
      ],
      [
        "cel_g_ombro"
      ],
      [
        "cel_g_cotovelo"
      ],
